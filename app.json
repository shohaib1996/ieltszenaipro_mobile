{
  "expo": {
    "name": "IELTSZen AI",
    "slug": "ieltszen-ai-mobile",
    "version": "1.0.0",
    "description": "AI-powered IELTS exam preparation: Reading, Listening, Writing, and Speaking practice with instant band-score feedback.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ieltszenai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ieltszenai.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.ieltszenai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0F1E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "IELTSZen AI uses your microphone to record your answers during Speaking practice tests."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c804d47-021b-4745-817b-2f88228241df"
      }
    }
  }
}
